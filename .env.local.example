# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Vercel AI Gateway ────────────────────────────────────────────────────────
# Opción A (recomendada): OIDC via Vercel — ejecutar: vercel env pull .env.local
# No se necesita clave manual si usas OIDC.
#
# Opción B: API key directa (para entornos sin Vercel CLI)
AI_GATEWAY_API_KEY=your-ai-gateway-api-key-here

# ─── Tavily (Pulso Digital — monitoreo de redes) ─────────────────────────────
# Obtener en: https://tavily.com → Dashboard → API Keys
TAVILY_API_KEY=tvly-your-api-key-here
